    "contract": {
        "name": "NFTMarketplace",
        "desc": "NFT Marketplace Contract\n\nThis contract manages an NFT marketplace where users can:\n- Create NFTs for their art\n- List NFTs for sale with Algo payments\n- Buy NFTs from other users\n- View marketplace listings\n\nFeatures:\n- Asset creation and management\n- Marketplace listings with pricing\n- Secure payment handling\n- Metadata storage for art information\n- Location-based NFT discovery",
        "methods": [
            {
                "name": "initialize",
                "args": [
                    {
                        "type": "string",
                        "name": "marketplaceOwner",
                        "desc": "- Address of the marketplace owner"
                    },
                    {
                        "type": "uint64",
                        "name": "feePercentage",
                        "desc": "- Marketplace fee percentage (0-100)"
                    },
                    {
                        "type": "string",
                        "name": "feeAccount",
                        "desc": "- Account to receive marketplace fees"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "string"
                },
                "desc": "Initialize the marketplace contract"
            },
            {
                "name": "createListing",
                "args": [
                    {
                        "type": "uint64",
                        "name": "assetId",
                        "desc": "- The asset ID of the NFT"
                    },
                    {
                        "type": "uint64",
                        "name": "price",
                        "desc": "- Price in microAlgos"
                    },
                    {
                        "type": "string",
                        "name": "artTitle",
                        "desc": "- Title of the artwork"
                    },
                    {
                        "type": "string",
                        "name": "artDescription",
                        "desc": "- Description of the artwork"
                    },
                    {
                        "type": "uint64",
                        "name": "locationLat",
                        "desc": "- Latitude of the art location"
                    },
                    {
                        "type": "uint64",
                        "name": "locationLng",
                        "desc": "- Longitude of the art location"
                    },
                    {
                        "type": "string",
                        "name": "imageUrl",
                        "desc": "- URL of the art image"
                    },
                    {
                        "type": "string",
                        "name": "category",
                        "desc": "- Category of the art"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "string"
                },
                "desc": "Create a new NFT listing"
            },
            {
                "name": "buyNFT",
                "args": [
                    {
                        "type": "uint64",
                        "name": "assetId",
                        "desc": "- The asset ID of the NFT to buy"
                    },
                    {
                        "type": "string",
                        "name": "seller",
                        "desc": "- Address of the seller"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "string"
                },
                "desc": "Buy an NFT from the marketplace"
            },
            {
                "name": "cancelListing",
                "args": [
                    {
                        "type": "uint64",
                        "name": "assetId",
                        "desc": "- The asset ID of the NFT"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "string"
                },
                "desc": "Cancel a listing"
            },
            {
                "name": "updateListingPrice",
                "args": [
                    {
                        "type": "uint64",
                        "name": "assetId",
                        "desc": "- The asset ID of the NFT"
                    },
                    {
                        "type": "uint64",
                        "name": "newPrice",
                        "desc": "- New price in microAlgos"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "string"
                },
                "desc": "Update listing price"
            },
            {
                "name": "getListingInfo",
                "args": [
                    {
                        "type": "uint64",
                        "name": "assetId",
                        "desc": "- The asset ID of the NFT"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "(uint64,uint64,string,string,string,uint64,uint64,string,string)",
                    "desc": "Listing information"
                },
                "desc": "Get listing information"
            },
            {
                "name": "getMarketplaceStats",
                "args": [],
                "readonly": false,
                "returns": {
                    "type": "(uint64,uint64,string,string)",
                    "desc": "Marketplace statistics"
                },
                "desc": "Get marketplace statistics"
            },
            {
                "name": "searchListingsByLocation",
                "args": [
                    {
                        "type": "uint64",
                        "name": "centerLat",
                        "desc": "- Center latitude"
                    },
                    {
                        "type": "uint64",
                        "name": "centerLng",
                        "desc": "- Center longitude"
                    },
                    {
                        "type": "uint64",
                        "name": "radiusKm",
                        "desc": "- Search radius in kilometers"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "uint64[]",
                    "desc": "Array of asset IDs within the radius"
                },
                "desc": "Search listings by location (within radius)"
            },
            {
                "name": "searchListingsByCategory",
                "args": [
                    {
                        "type": "string",
                        "name": "category",
                        "desc": "- Category to search for"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "uint64[]",
                    "desc": "Array of asset IDs in the category"
                },
                "desc": "Search listings by category"
            },
            {
                "name": "updateMarketplaceFee",
                "args": [
                    {
                        "type": "uint64",
                        "name": "newFeePercentage",
                        "desc": "- New fee percentage (0-100)"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "string"
                },
                "desc": "Update marketplace fee (only marketplace owner)"
            },
            {
                "name": "transferOwnership",
                "args": [
                    {
                        "type": "string",
                        "name": "newOwner",
                        "desc": "- Address of the new owner"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "string"
                },
                "desc": "Transfer marketplace ownership (only current owner)"
            },
            {
                "name": "emergencyWithdraw",
                "args": [
                    {
                        "type": "uint64",
                        "name": "amount",
                        "desc": "- Amount to withdraw in microAlgos"
                    },
                    {
                        "type": "string",
                        "name": "recipient",
                        "desc": "- Address to receive the Algo"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "string"
                },
                "desc": "Emergency function to withdraw Algo (only marketplace owner)"
            }
        ],
        "networks": {}
    },
